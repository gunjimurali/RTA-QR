generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QRRecord {
  id          String   @id @default(uuid())
  heading     String
  subheading  String
  comment     String
  logoData    String   @db.Text
  createdAt   DateTime @default(now())
}